# Copia este archivo a .env y pega tus claves. El archivo .env no se sube a git.

# ElevenLabs: voz, efectos de sonido y música en loop. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Opcional. Lista las voces con: npm run voces
ELEVENLABS_VOICE_ID=
# Opcional. Estilo de la música de fondo para: npm run sonidos -- musica
MUSICA_PROMPT=

# Pexels: videos de stock verticales para el fondo. Gratis en https://www.pexels.com/api/
PEXELS_API_KEY=

# fal.ai: imágenes y video con IA. Clave en https://fal.ai/dashboard/keys, saldo en Billing.
FAL_KEY=
# Opcionales
# IMAGEN_PROVEEDOR=pollinations fuerza el generador gratis sin clave
IMAGEN_PROVEEDOR=
FAL_IMAGEN_MODEL=
FAL_VIDEO_MODEL=
FAL_VIDEO_IMG_MODEL=

# Google AI Studio (Gemini). Clave gratis en https://aistudio.google.com/apikey
# Gratis: escribir guiones (npm run guion). Imágenes Nano Banana requieren facturación activa.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_IMAGEN_MODEL=
