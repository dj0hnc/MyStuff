# Copia este archivo a .env y pega tus claves. El archivo .env no se sube a git.

# ElevenLabs: voz, efectos de sonido y música en loop. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Opcional. Lista las voces con: npm run voces
ELEVENLABS_VOICE_ID=
# Opcional. Estilo de la música de fondo para: npm run sonidos -- musica
MUSICA_PROMPT=

# Pexels: videos de stock verticales para el fondo. Gratis en https://www.pexels.com/api/
PEXELS_API_KEY=

# fal.ai: imágenes y video con IA. Clave en https://fal.ai/dashboard/keys, saldo en Billing.
FAL_KEY=
# Opcionales
# IMAGEN_PROVEEDOR=pollinations fuerza el generador gratis sin clave
IMAGEN_PROVEEDOR=
FAL_IMAGEN_MODEL=
FAL_VIDEO_MODEL=
FAL_VIDEO_IMG_MODEL=

# Google AI Studio (Gemini). Clave gratis en https://aistudio.google.com/apikey
# Gratis: escribir guiones (npm run guion). Imágenes Nano Banana requieren facturación activa.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_IMAGEN_MODEL=
# Voz gratis de Gemini (se usa sola cuando ElevenLabs se agota). VOZ_PROVEEDOR=gemini la fuerza.
VOZ_PROVEEDOR=
GEMINI_VOICE=Puck
GEMINI_VOICE_STYLE=
# Whisper local para tiempos por palabra: tiny | base | small
WHISPER_MODEL=base

# Video con IA gratis (npm run clips). Con una basta; se prueban en este orden.
# Pixazo: LTX 2.5 gratis en preview, sin tarjeta. Clave en https://api-console.pixazo.ai/api_keys
PIXAZO_API_KEY=
# free.ai: 30,000 tokens/día (2-3 clips). Registro con correo en https://free.ai/signup/
FREEAI_API_KEY=
# Pollinations: Wan, Seedance, Grok Imagine, Veo por "pollen". Clave en https://enter.pollinations.ai
POLLINATIONS_API_KEY=
# Opcionales
CLIPS_PROVEEDOR=
CLIPS_SEGUNDOS=5
